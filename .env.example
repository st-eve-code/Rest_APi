# ---------------------------------------------------------------------------
# Copy this file to `.env` and adjust the values.
#   cp .env.example .env      (macOS / Linux)
#   Copy-Item .env.example .env   (Windows PowerShell)
#
# `.env` is git-ignored so your real credentials never get committed.
# ---------------------------------------------------------------------------

# Which app environment: development | test | production
NODE_ENV=development

# Port the HTTP server listens on
PORT=3000

# Which storage engine to use:
#   memory    -> a plain JavaScript array. No database to install.
#               Data is wiped every time you restart the server.
#               Great for learning the API first.
#   postgres  -> real PostgreSQL. Data survives restarts.
DB_DRIVER=memory

# PostgreSQL connection string (only used when DB_DRIVER=postgres)
# Format: postgres://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
#
# Common local setups:
#   default postgres install ...... postgres://postgres:postgres@localhost:5432/ado_test
#   Docker (docker-compose) ....... postgres://postgres:postgres@localhost:5432/ado_test
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ado_test

# How many database connections to keep open in the pool (max 20 on most free DBs)
DATABASE_POOL_MAX=10

# If "true", the server logs every SQL query it runs. Handy while learning.
DATABASE_LOG_QUERIES=false

# Allowed browser origins for CORS. Use "*" during local development.
CORS_ORIGIN=*

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
# Generate your own secrets. Never reuse the sample values, and never commit a
# real secret -- `.env` is git-ignored for exactly this reason:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# The server validates these at startup and refuses to run without them.
JWT_SECRET=change-me-to-48-random-hex-characters-minimum-32

# MUST be different from JWT_SECRET. A separate secret means a leaked access
# token cannot be used to mint refresh tokens.
JWT_REFRESH_SECRET=change-me-to-a-different-48-random-hex-string

# Access tokens are short-lived on purpose: 15 minutes.
JWT_ACCESS_TTL=15m

# Refresh tokens last longer, and each one can only be used once.
JWT_REFRESH_TTL=7d

# The `iss` claim. Lets the server reject tokens minted by a different app.
JWT_ISSUER=ado_test_core

# Name of the httpOnly cookie holding the refresh token.
AUTH_COOKIE_NAME=refresh_token