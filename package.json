{
  "name": "ado-test-core",
  "version": "1.0.0",
  "private": true,
  "description": "A REST API for managing items, built with Node.js, Express, PostgreSQL, TypeScript + JavaScript.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server.ts",
    "dev:web": "npm --prefix client run dev",
    "build": "tsc -p tsconfig.build.json",
    "build:web": "npm --prefix client run build",
    "start": "node dist/server.js",
    "preview:web": "npm --prefix client run preview",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "npm --prefix client run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:make-admin": "tsx src/db/makeAdmin.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "concurrently": "^9.1.2",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
